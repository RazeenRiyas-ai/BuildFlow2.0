{
  "name": "buildflow-server",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate:up": "dotenv -e .env -- node-pg-migrate up",
    "migrate:down": "dotenv -e .env -- node-pg-migrate down",
    "migrate:create": "node-pg-migrate create",
    "seed": "dotenv -e .env -- tsx src/db/seed.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "dotenv -e .env.test -- vitest run",
    "migrate:test:up": "dotenv -e .env.test -- node-pg-migrate up",
    "seed:test": "dotenv -e .env.test -- tsx src/db/seed.ts"
  },
  "dependencies": {
    "@sentry/node": "^10.74.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "image-size": "^1.2.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "pg": "^8.12.0",
    "socket.io": "^4.8.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^7.2.1",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^7.4.2",
    "node-pg-migrate": "^7.6.1",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
