DATABASE_URL=postgres://localhost:5432/buildflow_dev
JWT_ACCESS_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-a-different-long-random-value
PORT=4000
CORS_ORIGIN=*
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
UPLOADS_DIR=uploads
MAX_PHOTO_UPLOAD_BYTES=8388608
MAX_PHOTO_DIMENSION_PX=6000
STALE_ORDER_REMINDER_THRESHOLD_MINUTES=240
STALE_ORDER_REMINDER_DELIVERY_THRESHOLD_MINUTES=600
STALE_ORDER_REMINDER_CHECK_INTERVAL_MINUTES=30
CLEANUP_JOB_INTERVAL_MINUTES=60
# Optional — leave unset (as below) to disable Sentry error tracking entirely; this is the safe
# default and the app behaves identically either way. Set a real DSN to enable it.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
